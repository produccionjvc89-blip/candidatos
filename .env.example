# Google Cloud Configuration
GOOGLE_PROJECT_ID=your-firebase-project-id
GOOGLE_PRIVATE_KEY=your-firebase-private-key
GOOGLE_CLIENT_EMAIL=your-firebase-client-email
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE=7d

# APIs Configuration
NEWSAPI_KEY=your-newsapi-key
GITHUB_TOKEN=your-github-token
ARCHIVE_API_URL=https://archive.org/advancedsearch.php
MACTODON_INSTANCE=mastodon.social

# Database
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
